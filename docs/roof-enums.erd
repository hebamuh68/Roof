    "memoEntities": {
      "2rGgnXf5x3S_8_WaMqcL1": {
        "id": "2rGgnXf5x3S_8_WaMqcL1",
        "value": "One Property can have many Reviews (multiple users review it)\nOne Review is about one Property only\nSo it's 1:M — Property (1) to Review (M).\n\nAnd for User - Review?\nOne User can write many Reviews\nOne Review is written by one User",
        "ui": {
          "x": 1095.129,
          "y": 764.0985,
          "zIndex": 370,
          "width": 368,
          "height": 110,
          "color": ""
        },
        "meta": {
          "updateAt": 1771113729968,
          "createAt": 1771110953743
        }
      },
      "2fd50401bba24a05bbf9a": {
        "id": "2fd50401bba24a05bbf9a",
        "value": "Facilities & Constraints stored as ENUM arrays on Property.\n\nCREATE TYPE FacilityType AS ENUM(\n  'furnished', 'semi_furnished', 'parking',\n  'private_bathroom', 'balcony', 'wifi', ...\n);\n\nCREATE TYPE ConstraintType AS ENUM(\n  'smoking', 'pets', 'couples',\n  'kids', 'visitors', ...\n);\n\nProperty.facilities = FacilityType[]\nProperty.constraints = ConstraintType[]",
        "ui": {
          "x": 1375,
          "y": 444,
          "zIndex": 900,
          "width": 500,
          "height": 220,
          "color": ""
        },
        "meta": {
          "updateAt": 1772218653482,
          "createAt": 1772218039528
        }
      }
    }
